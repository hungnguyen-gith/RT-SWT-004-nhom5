import matplotlib.pyplot as plt
import numpy as np
 
# ----------------------------
# Dữ liệu
# ----------------------------
studies = ["Wang et al. (2024)", "Ryan et al. (2024)",
           "Aminata et al. (2025)", "Huang et al. (2026)"]
branch_coverage = [48, 66, 31, 30]  # % Branch Coverage
 
# ----------------------------
# Vẽ biểu đồ
# ----------------------------
fig, ax = plt.subplots(figsize=(8, 5))
 
y_pos = np.arange(len(studies))
ax.barh(y_pos, branch_coverage[::-1], color="#4472C4", height=0.5)
 
ax.set_yticks(y_pos)
ax.set_yticklabels(studies[::-1])
ax.set_xlim(0, 70)
ax.set_title("Comparison of Report Branch Coverage (%)", fontsize=16, pad=20)
ax.text(0.98, 1.05, "N=4", transform=ax.transAxes,
        fontsize=14, ha="right", va="bottom")
 
ax.grid(axis="x", color="#D9D9D9", linewidth=0.8)
ax.set_axisbelow(True)
for spine in ["top", "right", "left"]:
    ax.spines[spine].set_visible(False)
 
plt.tight_layout()
plt.savefig("Comparison.png", dpi=200)
plt.show()


