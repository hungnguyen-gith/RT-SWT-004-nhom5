import matplotlib.pyplot as plt
 
# ----------------------------
# Dữ liệu
# ----------------------------
branch_coverage = [48, 66, 31, 30]  # % Branch Coverage
 
# ----------------------------
# Vẽ biểu đồ Distribution
# ----------------------------
fig, ax = plt.subplots(figsize=(8, 7))
 
ax.boxplot(branch_coverage, widths=0.4, patch_artist=True,
           showmeans=True,
           meanprops={"marker": "x", "markerfacecolor": "black",
                      "markeredgecolor": "black", "markersize": 8},
           medianprops={"color": "#2E4E8C"},
           boxprops={"facecolor": "#4472C4", "edgecolor": "#2E4E8C"},
           whiskerprops={"color": "#2E4E8C"},
           capprops={"color": "#2E4E8C"})
 
ax.set_title("Distribution of Branch Coverage (%)", fontsize=18, pad=20)
ax.set_ylim(0, 50)
ax.set_xticks([1])
ax.set_xticklabels(["1"])
 
ax.grid(axis="y", color="#D9D9D9", linewidth=0.8)
ax.set_axisbelow(True)
for spine in ["top", "right"]:
    ax.spines[spine].set_visible(False)
 
plt.tight_layout()
plt.savefig("Distribution.png", dpi=200)
plt.show()
