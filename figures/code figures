import matplotlib.pyplot as plt
import seaborn as sns

sns.set_theme(style="whitegrid")

plt.figure(figsize=(6,5))

sns.boxplot(
    data=df[['bc_gpt','bc_pynguin']],
    palette=["#4a86e8","#f28e2b"],
    showmeans=True,
    meanprops={
        "marker":"x",
        "markeredgecolor":"black",
        "markersize":8
    }
)

plt.title("Branch Coverage Comparison")

plt.ylabel("Branch Coverage (%)")

plt.xticks(
    [0,1],
    ["GPT-4o mini","Pynguin"]
)

plt.tight_layout()

plt.savefig(
    "bc_boxplot.png",
    dpi=300
)

plt.show()

plt.figure(figsize=(6,5))

sns.boxplot(
    data=df[['ms_gpt','ms_pynguin']],
    palette=["#4a86e8","#f28e2b"],
    showmeans=True,
    meanprops={
        "marker":"x",
        "markeredgecolor":"black",
        "markersize":8
    }
)

plt.title("Mutation Score Comparison")

plt.ylabel("Mutation Score (%)")

plt.xticks(
    [0,1],
    ["GPT-4o mini","Pynguin"]
)

plt.tight_layout()

plt.savefig(
    "ms_boxplot.png",
    dpi=300
)

plt.show()

gpt = df["csr_gpt"].mean()*100

if "csr_pynguin" in df.columns:

    pynguin = df["csr_pynguin"].mean()*100

    labels = ["GPT-4o mini","Pynguin"]
    values = [gpt,pynguin]

else:

    labels = ["GPT-4o mini"]
    values = [gpt]

plt.figure(figsize=(5,5))

bars = plt.bar(
    labels,
    values,
    color=["#4a86e8","#f28e2b"][:len(values)]
)

plt.ylabel("Compilation Success Rate (%)")

plt.ylim(0,100)

for bar in bars:

    y = bar.get_height()

    plt.text(
        bar.get_x()+bar.get_width()/2,
        y+1,
        f"{y:.1f}%",
        ha="center"
    )

plt.tight_layout()

plt.savefig(
    "csr_bar.png",
    dpi=300
)

plt.show()
