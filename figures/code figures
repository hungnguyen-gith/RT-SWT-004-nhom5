import pandas as pd
import matplotlib.pyplot as plt

# Branch Coverage + CSR
df = pd.read_csv("bc_csr(4).csv")

# Mutation Score
ms_df = pd.read_csv("mutation_scores(2).csv")

fig, ax = plt.subplots(figsize=(6,5))

ax.boxplot(
    [df['bc_gpt'], df['bc_pynguin']],
    labels=['GPT-4o mini', 'Pynguin'],
    showmeans=True
)

ax.set_title("Branch Coverage Comparison")
ax.set_ylabel("Branch Coverage (%)")

plt.tight_layout()
plt.savefig("bc_boxplot.png", dpi=300)
plt.show()

fig, ax = plt.subplots(figsize=(6,5))

ax.boxplot(
    [ms_df['ms_gpt'], ms_df['ms_pynguin']],
    labels=['GPT-4o mini', 'Pynguin'],
    showmeans=True
)

ax.set_title("Mutation Score Comparison")
ax.set_ylabel("Mutation Score (%)")

plt.tight_layout()
plt.savefig("ms_boxplot.png", dpi=300)
plt.show()


csr_gpt = df['csr_gpt'].mean() * 100
if 'csr_pynguin' in df.columns:
    csr_pynguin = df['csr_pynguin'].mean() * 100
else:
    csr_pynguin = 0

labels = ['GPT-4o mini', 'Pynguin']
values = [csr_gpt, csr_pynguin]

fig, ax = plt.subplots(figsize=(5,5))

bars = ax.bar(labels, values)

ax.set_title("Compilation Success Rate Comparison")
ax.set_ylabel("Compilation Success Rate (%)")
ax.set_ylim(0, 100)

# Hiển thị giá trị trên cột
for bar in bars:
    h = bar.get_height()
    ax.text(
        bar.get_x() + bar.get_width()/2,
        h + 1,
        f"{h:.1f}%",
        ha='center',
        fontsize=10
    )

plt.tight_layout()
plt.savefig("csr_bar.png", dpi=300)
plt.show()
