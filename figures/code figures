# 2. Cấu hình kích thước và nền biểu đồ giống phong cách tối giản
plt.figure(figsize=(8, 5))
sns.set_theme(style="whitegrid") 

# 3. Vẽ biểu đồ hộp với các tùy chỉnh màu sắc và ký hiệu hiển thị Mean (X)
box_plot = sns.boxplot(
    y=data, 
    color="#4a86e8", 
    width=0.5,
    showmeans=True,  
    meanprops={"marker": "x", "markerfacecolor": "gray", "markeredgecolor": "gray", "markersize": 10}, 
    medianprops={"color": "#2c4d82", "linewidth": 1.5}, 
    whiskerprops={"color": "#2c4d82"},
    capprops={"color": "#2c4d82"}
)

# 4. Thiết lập tiêu đề và định dạng các trục
